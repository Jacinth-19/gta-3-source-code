include(FetchContent)

if(POLICY CMP0169)
    cmake_policy(SET CMP0169 OLD)
endif()

set(WAYPOINT_EXTERNAL_DIR "${CMAKE_CURRENT_SOURCE_DIR}/external")
set(FETCHCONTENT_UPDATES_DISCONNECTED ON)
set(FETCHCONTENT_QUIET OFF)

# Keep third-party projects from building their own tests/examples.
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ENTT_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ENTT_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(GLM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GLM_BUILD_INSTALL OFF CACHE BOOL "" FORCE)
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(JSON_Install OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SPDLOG_INSTALL OFF CACHE BOOL "" FORCE)

macro(waypoint_declare name repo commit)
    string(TOUPPER "${name}" _waypoint_upper)
    string(REPLACE "." "_" _waypoint_upper "${_waypoint_upper}")
    string(REPLACE "-" "_" _waypoint_upper "${_waypoint_upper}")

    set(_waypoint_dir "${WAYPOINT_EXTERNAL_DIR}/${name}")
    file(GLOB _waypoint_children "${_waypoint_dir}/*")
    if(IS_DIRECTORY "${_waypoint_dir}" AND _waypoint_children)
        set(FETCHCONTENT_SOURCE_DIR_${_waypoint_upper} "${_waypoint_dir}")
        message(STATUS "Waypoint dependency ${name}: using external/${name}")
    else()
        message(STATUS "Waypoint dependency ${name}: fetching locked revision ${commit}")
    endif()

    FetchContent_Declare(${name}
        GIT_REPOSITORY "${repo}"
        GIT_TAG "${commit}"
        GIT_SHALLOW FALSE
    )
endmacro()

macro(waypoint_populate name)
    FetchContent_GetProperties(${name})
    if(NOT ${name}_POPULATED)
        FetchContent_Populate(${name})
    endif()
endmacro()

# Core dependencies.
waypoint_declare(entt https://github.com/skypjack/entt.git d4014c74dc3793aba95ae354d6e23a026c2796db)
waypoint_declare(glm https://github.com/g-truc/glm.git 0af55ccecd98d4e5a8d1fad7de25ba429d60e863)
waypoint_declare(json https://github.com/nlohmann/json.git 55f93686c01528224f448c19128836e7df245f72)
waypoint_declare(spdlog https://github.com/gabime/spdlog.git 6fa36017cfd5731d617e1a934f0e5ea9c4445b13)
FetchContent_MakeAvailable(entt glm json spdlog)

if(NOT TARGET EnTT::EnTT)
    add_library(waypoint_entt INTERFACE)
    target_include_directories(waypoint_entt INTERFACE "${entt_SOURCE_DIR}/src")
    add_library(EnTT::EnTT ALIAS waypoint_entt)
endif()

if(NOT TARGET glm::glm)
    add_library(waypoint_glm INTERFACE)
    target_include_directories(waypoint_glm INTERFACE "${glm_SOURCE_DIR}")
    add_library(glm::glm ALIAS waypoint_glm)
endif()

if(NOT TARGET nlohmann_json::nlohmann_json)
    add_library(waypoint_json INTERFACE)
    target_include_directories(waypoint_json INTERFACE "${json_SOURCE_DIR}/single_include")
    add_library(nlohmann_json::nlohmann_json ALIAS waypoint_json)
endif()

if(NOT TARGET spdlog::spdlog)
    add_library(waypoint_spdlog INTERFACE)
    target_include_directories(waypoint_spdlog INTERFACE "${spdlog_SOURCE_DIR}/include")
    target_compile_definitions(waypoint_spdlog INTERFACE SPDLOG_HEADER_ONLY)
    add_library(spdlog::spdlog ALIAS waypoint_spdlog)
endif()

if(WAYPOINT_BUILD_TESTS)
    waypoint_declare(doctest https://github.com/doctest/doctest.git 1da23a3e8119ec5cce4f9388e91b065e20bf06f5)
    FetchContent_MakeAvailable(doctest)
    if(NOT TARGET doctest::doctest)
        add_library(waypoint_doctest INTERFACE)
        target_include_directories(waypoint_doctest INTERFACE "${doctest_SOURCE_DIR}")
        add_library(doctest::doctest ALIAS waypoint_doctest)
    endif()
endif()

if(WAYPOINT_ENABLE_SCRIPTING)
    waypoint_declare(lua https://github.com/lua/lua.git 1ab3208a1fceb12fca8f24ba57d6e13c5bff15e3)
    waypoint_declare(sol2 https://github.com/ThePhD/sol2.git eba86625b707e3c8c99bbfc4624e51f42dc9e561)
    waypoint_populate(lua)
    waypoint_populate(sol2)

    if(NOT TARGET waypoint_lua)
        file(GLOB WAYPOINT_LUA_SOURCES "${lua_SOURCE_DIR}/*.c")
        list(FILTER WAYPOINT_LUA_SOURCES EXCLUDE REGEX ".*/lua\\.c$")
        list(FILTER WAYPOINT_LUA_SOURCES EXCLUDE REGEX ".*/luac\\.c$")
        list(FILTER WAYPOINT_LUA_SOURCES EXCLUDE REGEX ".*/ltests\\.c$")
        add_library(waypoint_lua STATIC ${WAYPOINT_LUA_SOURCES})
        target_include_directories(waypoint_lua PUBLIC "${lua_SOURCE_DIR}")
        if(UNIX)
            target_compile_definitions(waypoint_lua PRIVATE LUA_USE_POSIX)
            target_link_libraries(waypoint_lua PUBLIC m ${CMAKE_DL_LIBS})
        endif()
        set_target_properties(waypoint_lua PROPERTIES C_STANDARD 99)
    endif()

    if(NOT TARGET sol2::sol2)
        add_library(waypoint_sol2 INTERFACE)
        target_include_directories(waypoint_sol2 INTERFACE "${sol2_SOURCE_DIR}/include")
        target_link_libraries(waypoint_sol2 INTERFACE waypoint_lua)
        add_library(sol2::sol2 ALIAS waypoint_sol2)
    endif()
endif()

if(WAYPOINT_ENABLE_PHYSICS)
    waypoint_declare(jolt https://github.com/jrouwe/JoltPhysics.git 0373ec0dd762e4bc2f6acdb08371ee84fa23c6db)
    waypoint_populate(jolt)
    set(USE_ASSERTS OFF CACHE BOOL "" FORCE)
    set(DOUBLE_PRECISION OFF CACHE BOOL "" FORCE)
    set(GENERATE_DEBUG_SYMBOLS OFF CACHE BOOL "" FORCE)
    set(OVERRIDE_CXX_FLAGS OFF CACHE BOOL "" FORCE)
    set(INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "" FORCE)
    set(ENABLE_ALL_WARNINGS OFF CACHE BOOL "" FORCE)
    set(ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
    set(CPP_RTTI_ENABLED ON CACHE BOOL "" FORCE)
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    if(NOT TARGET Jolt)
        add_subdirectory("${jolt_SOURCE_DIR}/Build" "${CMAKE_BINARY_DIR}/external/jolt")
    endif()
endif()

if(WAYPOINT_ENABLE_RENDER OR WAYPOINT_BUILD_RUNTIME)
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
    set(SDL_TEST OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
    if(WAYPOINT_HEADLESS_BUILD AND UNIX AND NOT APPLE AND NOT ANDROID)
        set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
        set(SDL_X11 OFF CACHE BOOL "" FORCE)
        set(SDL_WAYLAND OFF CACHE BOOL "" FORCE)
    endif()
    waypoint_declare(sdl https://github.com/libsdl-org/SDL.git 877399b2b2cf21e67554ed9046410f268ce1d1b2)
    FetchContent_MakeAvailable(sdl)

    if(TARGET SDL3::SDL3)
        set(WAYPOINT_SDL_TARGET SDL3::SDL3 CACHE INTERNAL "")
    elseif(TARGET SDL3::SDL3-static)
        set(WAYPOINT_SDL_TARGET SDL3::SDL3-static CACHE INTERNAL "")
    elseif(TARGET SDL3-static)
        set(WAYPOINT_SDL_TARGET SDL3-static CACHE INTERNAL "")
    else()
        message(FATAL_ERROR "SDL3 target was not created")
    endif()
endif()

if(WAYPOINT_ENABLE_RENDER)
    waypoint_declare(bgfx https://github.com/bkaradzic/bgfx.git fbceed8df882df4f13d629ee5c4aa4a096a1addf)
    waypoint_declare(bx https://github.com/bkaradzic/bx.git f859f66472aabacc2847e7d7b04168e7146e9f98)

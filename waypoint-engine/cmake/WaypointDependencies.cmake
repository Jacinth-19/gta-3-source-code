    waypoint_populate(stb)
    waypoint_populate(tinygltf)
    if(NOT TARGET waypoint_stb)
        add_library(waypoint_stb INTERFACE)
        target_include_directories(waypoint_stb INTERFACE "${stb_SOURCE_DIR}")
    endif()
    if(NOT TARGET waypoint_tinygltf)
        add_library(waypoint_tinygltf INTERFACE)
        target_include_directories(waypoint_tinygltf INTERFACE "${tinygltf_SOURCE_DIR}")
        target_link_libraries(waypoint_tinygltf INTERFACE waypoint_stb nlohmann_json::nlohmann_json)
    endif()
endif()
